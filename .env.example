# Neon pooled connection string used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Neon direct connection string used by Drizzle migrations.
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Local: http://localhost:3000
# Production: the deployed HTTPS origin, without a trailing slash.
BETTER_AUTH_URL="http://localhost:3000"
